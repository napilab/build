From af3c33a91c2b3a23a5df5e75c5904487a5e9fe11 Mon Sep 17 00:00:00 2001
From: Dmitry Novikov <dj.novikov@gmail.com>
Date: Fri, 27 Nov 2026 21:46:19 +0000
Subject: [PATCH] Add NapiLab NAPI-M (RK3562) board

NAPI-M v1.0: RK3562, 2 GB LPDDR3, RK809, eMMC, microSD, console on UART0
at 1500000. Built on the RK3562 family support that comes with the
KICKPI K3B patch.

The device tree is a boot-time subset: console, PMIC rails, eMMC and SD.
The rails and their voltages are those the vendor U-Boot of the board
sets; DCDC_REG1..4 are not touched (BUCK3 has external feedback).
SPL does not use the PMIC.
---
 arch/arm/dts/rk3562-napi-m-u-boot.dtsi        |  12 ++
 arch/arm/mach-rockchip/rk3562/Kconfig         |   7 +
 board/napilab/napi_m_rk3562/Kconfig           |  12 ++
 configs/napi-m-rk3562_defconfig               |  60 ++++++
 .../src/arm64/rockchip/rk3562-napi-m.dts      | 171 ++++++++++++++++++
 include/configs/napi_m_rk3562.h               |  12 ++
 6 files changed, 274 insertions(+)
 create mode 100644 arch/arm/dts/rk3562-napi-m-u-boot.dtsi
 create mode 100644 board/napilab/napi_m_rk3562/Kconfig
 create mode 100644 configs/napi-m-rk3562_defconfig
 create mode 100644 dts/upstream/src/arm64/rockchip/rk3562-napi-m.dts
 create mode 100644 include/configs/napi_m_rk3562.h

diff --git a/arch/arm/dts/rk3562-napi-m-u-boot.dtsi b/arch/arm/dts/rk3562-napi-m-u-boot.dtsi
new file mode 100644
index 00000000..9d98aa7d
--- /dev/null
+++ b/arch/arm/dts/rk3562-napi-m-u-boot.dtsi
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk3562-u-boot.dtsi"
+
+/*
+ * SPL does not touch the PMIC, as the vendor SPL of this board did not:
+ * the boot ROM has already read SPL from the same card or eMMC, so the
+ * rails RK809 powers up by default are enough to load U-Boot proper.
+ */
+&sdmmc0 {
+	u-boot,spl-fifo-mode;
+};
